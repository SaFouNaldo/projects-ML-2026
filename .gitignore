# ---- Data (never commit: too big, and provided by the course) ----
data/*
!data/.gitkeep
*.zip
*.npy
*.npz
!models/*.npz

# CSVs are data by default, except the small shared tables we DO track
*.csv
!notebooks/feature_selection/*.csv

# ---- Model outputs ----
submissions/
outputs/
*.pkl
weights/

# ---- Files staged for deletion (not part of the project) ----
_to_delete/

# ---- Python ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ---- LaTeX ----
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.fdb_latexmk
*.fls
*.toc

# ---- Editors / OS ----
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini
